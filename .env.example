# SunShade Systems Documentation Portal Environment Variables

# Public URL of the documentation portal
NEXT_PUBLIC_APP_URL=https://docs.sunshade.icu

# Cloudflare Pages deployment variables (set in GitHub Actions secrets or local provisioning)
# CLOUDFLARE_API_TOKEN=your-api-token
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CLOUDFLARE_ZONE_ID=your-sunshade-icu-zone-id

# GitHub Actions secret for syncing private documentation submodules
# SUBMODULES_PAT=ghp_...

# Optional: SunShade Tracker API key for automated Living Binder reprint drift alerts
# TRACKER_API_KEY=your-tracker-api-key
